{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "rootDir": "..",
  "testMatch": ["<rootDir>/test/e2e/**/*.e2e.spec.ts"],
  "transform": {
    "^.+\\.ts$": ["ts-jest", { "tsconfig": "<rootDir>/tsconfig.json" }]
  },
  "setupFiles": ["<rootDir>/test/setup.integration.ts"],
  "testTimeout": 30000,
  "clearMocks": true,
  "forceExit": true
}

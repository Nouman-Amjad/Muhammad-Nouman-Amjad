# Application
NODE_ENV=development
PORT=3000
REQUEST_TIMEOUT_MS=15000
MAX_REQUEST_BODY_BYTES=16384

# Database (PostgreSQL)
DATABASE_URL=postgresql://ggi:ggi@localhost:5432/ggi?schema=public

# CORS — comma-separated allowlist of trusted origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Keycloak (OIDC provider)
OIDC_ISSUER_URL=http://localhost:8080/realms/ggi
OIDC_AUDIENCE=ggi-backend
OIDC_JWKS_URI=http://localhost:8080/realms/ggi/protocol/openid-connect/certs

# Session-bound token layer
SESSION_BINDING_SECRET=change-me-in-production-min-32-chars
SESSION_TTL_SECONDS=3600

# Rate limiting (requests per window)
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_SUBSCRIPTION_PER_MINUTE=30

# Mocked OpenAI latency simulation (milliseconds)
OPENAI_MOCK_MIN_LATENCY_MS=150
OPENAI_MOCK_MAX_LATENCY_MS=600
